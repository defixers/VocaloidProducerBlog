[Unit]
Description=Verify the latest Vocaloid Producer Blog backup
After=local-fs.target

[Service]
Type=oneshot
TimeoutStartSec=2h
User=vpb-backup
Group=vpb-backup
WorkingDirectory=/opt/vocaloid-producer-blog-backup
Environment=NODE_ENV=production
EnvironmentFile=/etc/vocaloid-producer-blog/backup.env
ExecStart=/usr/bin/node /opt/vocaloid-producer-blog-backup/scripts/restore-drill.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/vocaloid-producer-blog /var/lib/vocaloid-producer-blog/drills
UMask=0077

[Install]
WantedBy=multi-user.target
