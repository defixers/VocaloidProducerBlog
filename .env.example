# Your server-side sync endpoint. Keep Bilibili cookies and signing secrets on the server.
# Expected response: { "videos": [...], "dynamics": [...] }
VITE_BILIBILI_SYNC_URL=/api/bilibili/feed

# Optional public profile link used by your deployment.
VITE_BILIBILI_SPACE_URL=https://space.bilibili.com/1858510441

# Server-only Bilibili sync settings. Do not prefix the cookie with VITE_.
BILIBILI_UID=1858510441
BILIBILI_COOKIE=

# Required by the administration API in production.
NODE_ENV=production
APP_ORIGIN=https://www.utopiap.top
ADMIN_PASSWORD_HASH=replace-with-output-of-npm-run-security-hash-password
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
PORT=8787
