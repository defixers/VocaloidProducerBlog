# Your server-side sync endpoint. Keep Bilibili cookies and signing secrets on the server.
# Expected response: { "videos": [...], "dynamics": [...] }
VITE_BILIBILI_SYNC_URL=/api/bilibili/feed

# Optional public profile link used by your deployment.
VITE_BILIBILI_SPACE_URL=https://space.bilibili.com/1858510441

# Server-only Bilibili sync settings. Do not prefix the cookie with VITE_.
BILIBILI_UID=1858510441
BILIBILI_COOKIE=
BILIBILI_UPSTREAM_TIMEOUT_SECONDS=8
BILIBILI_JSON_MAX_MB=2
BILIBILI_IMAGE_MAX_MB=5
BILIBILI_REDIRECT_LIMIT=3
BILIBILI_IMAGE_CACHE_MB=32
BILIBILI_IMAGE_CACHE_ENTRIES=64
PUBLIC_RATE_WINDOW_MINUTES=10
BILIBILI_FEED_RATE_LIMIT=60
BILIBILI_IMAGE_RATE_LIMIT=180
BILIBILI_FEED_CONCURRENCY=4
BILIBILI_IMAGE_CONCURRENCY=8
RESOURCE_DOWNLOAD_RATE_LIMIT=60
RESOURCE_DOWNLOAD_CONCURRENCY=4
RESOURCE_DOWNLOAD_MAX_MB=100
RESOURCE_DOWNLOAD_TIMEOUT_SECONDS=120

# Required by the administration API in production.
NODE_ENV=production
APP_ORIGIN=https://www.utopiap.top,https://utopiap.top
# Optional comma-separated hostnames for remote article covers. Local /images/ paths are always allowed.
ARTICLE_IMAGE_HOSTS=
ADMIN_PASSWORD_HASH=replace-with-output-of-npm-run-security-hash-password
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_IP_LIMIT=10
ADMIN_LOGIN_ACCOUNT_LIMIT=30
ADMIN_LOGIN_BACKOFF_BASE_MS=500
ADMIN_LOGIN_BACKOFF_MAX_MS=30000
ADMIN_LOGIN_CONCURRENCY=2
ADMIN_WRITE_WINDOW_MINUTES=10
ADMIN_WRITE_LIMIT=60
ADMIN_WRITE_CONCURRENCY=2
APP_STORAGE_ROOT=
UPLOAD_MAX_FILE_MB=100
UPLOAD_TOTAL_QUOTA_MB=1024
UPLOAD_WINDOW_MINUTES=60
UPLOAD_LIMIT=10
UPLOAD_CONCURRENCY=1
UPLOAD_ARCHIVE_MAX_UNCOMPRESSED_MB=512
UPLOAD_ARCHIVE_MAX_FILES=1000
UPLOAD_ARCHIVE_MAX_DEPTH=10
UPLOAD_ARCHIVE_MAX_RATIO=100
UPLOAD_VIRUS_SCAN_COMMAND=clamscan
UPLOAD_VIRUS_SCAN_ARGS=["--no-summary"]
UPLOAD_SCAN_TIMEOUT_SECONDS=60
TRUST_PROXY_HOPS=1
SERVER_HEADERS_TIMEOUT_SECONDS=15
SERVER_REQUEST_TIMEOUT_SECONDS=120
PORT=8787
